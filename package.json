{
  "name": "depths-of-the-fractured-mind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sprites:check && npm run characters:check && npm run presence:check && tsc && vite build && npm run assets:check",
    "assets:build": "node utils/build-web-assets.mjs",
    "assets:check": "node utils/check-web-assets.mjs",
    "assets:provenance": "node utils/check-asset-provenance.mjs",
    "sprites:build": "node utils/build-hero-atlases.mjs",
    "sprites:check": "node utils/build-hero-atlases.mjs --check",
    "bench:combat": "node utils/benchmark-combat.mjs",
    "bench:dungeon": "node utils/benchmark-dungeon.mjs",
    "capture:golden": "npm run build && node utils/capture-golden-room.mjs",
    "bench:load": "node utils/benchmark-load.mjs",
    "baseline:capture": "npm run build && node utils/capture-baseline.mjs",
    "preview": "vite preview",
    "validate:events": "node utils/validate-events.cjs",
    "test:unit": "vitest run tests/*.test.ts",
    "test:smoke": "npm run build && playwright test",
    "audit:security": "npm audit --audit-level=moderate",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run typecheck && npm run validate:events && npm run test:unit",
    "ci": "npm run lint && npm run build && npm run validate:events && npm run test:unit && npm run test:smoke && npm run audit:security",
    "characters:build": "node utils/build-character-atlases.mjs",
    "characters:check": "node utils/build-character-atlases.mjs --check",
    "capture:characters": "npm run build && node utils/capture-character-art.mjs",
    "presence:build": "node utils/build-presence-atlases.mjs",
    "presence:check": "node utils/build-presence-atlases.mjs --check",
    "capture:presence": "npm run build && node utils/capture-presence.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.187.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
